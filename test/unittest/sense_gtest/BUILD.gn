import("//build/test.gni")
SOURCE_DIR = "../../../"
import("$SOURCE_DIR/telephony_core_service.gni")

ohos_unittest("sense_gtest_target") {
  install_enable = true
  subsystem_name = "telephony"
  part_name = "core_service"
  test_module = "core_service"
  module_out_path = part_name + "/" + test_module

  sources = [
    "sense_gtest.cpp",
    # tested src
    "$SOURCE_DIR/frameworks/js/sense/src/hidden_camera_detection_callback.cpp",
    "$SOURCE_DIR/frameworks/js/napi/napi_util.cpp",
  ]

  include_dirs = [
    "$SOURCE_DIR/frameworks/js/sense/src",
    "$SOURCE_DIR/frameworks/js/sense/include",
    "$SOURCE_DIR/frameworks/js/napi",
    "$SOURCE_DIR/frameworks/js/napi/include",
    "$SOURCE_DIR/utils/log/include",
  ]

  configs = [ "$SOURCE_DIR/utils:telephony_log_config" ]

  deps = [
    "$SOURCE_DIR/interfaces/innerkits:tel_core_service_api",
    "$SOURCE_DIR/utils:libtel_common",
  ]

  external_deps = [
    "c_utils:utils",
    "ffrt:libffrt",
    "googletest:gtest_main",
    "hilog:libhilog",
    "init:libbegetutil",
    "ipc:ipc_single",
    "napi:ace_napi",
  ]

  defines = [
    "TELEPHONY_LOG_TAG = \"CoreServiceSenseGtest\"",
    "LOG_DOMAIN = 0xD001F04",
  ]
}

group("sense_gtest") {
  testonly = true
  deps = [
    ":sense_gtest_target",
  ]
}
